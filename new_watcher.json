{
  "trigger": {
    "schedule": { "interval": "24h" }
  },
  "metadata": {
    "org": "085047404459",
    "environment": "reporting-pipelines-spark-cluster",
    "source_index": "*-cloudwatch-*",
    "target_index": "reporting-cloud-data-pipeline"
  },
  "input": {
    "chain": {
      "inputs": [
        {
          "latest_success": {
            "search": {
              "request": {
                "indices": [ "*-cloudwatch-*" ],
                "rest_total_hits_as_int": true,
                "body": {
                  "size": 1,
                  "sort": [
                    { "@timestamp": { "order": "desc" } }
                  ],
                  "_source": [
                    "@timestamp",
                    "cls.organization",
                    "record.environment",
                    "record.message"
                  ],
                  "query": {
                    "bool": {
                      "filter": [
                        { "term": { "cls.organization.keyword": "085047404459" } },
                        { "term": { "record.environment.keyword": "reporting-pipelines-spark-cluster" } },
                        {
                          "match_phrase": {
                            "record.message": "Successfully processed file"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "extract_file_and_time": {
            "transform": {
              "script": {
                "lang": "painless",
                "source": """
                  if (ctx.payload.latest_success.hits.total == 0) return ['found': false];

                  def hit = ctx.payload.latest_success.hits.hits[0];
                  def msg = hit._source.containsKey('record') && hit._source.record != null ? hit._source.record.message : hit._source['record.message'];
                  if (msg == null) msg = '';

                  // Parse leading datetime in message: "YYYY-MM-DD HH:MM:SS"
                  def successMillis = null;
                  def mTime = /^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/.matcher(msg);
                  if (mTime.find()) {
                    def dt = mTime.group(1).replace(' ', 'T') + 'Z';
                    try { successMillis = java.time.Instant.parse(dt).toEpochMilli(); } catch (Exception e) {}
                  }
                  if (successMillis == null) {
                    // fallback to @timestamp
                    def ts = hit._source['@timestamp'];
                    if (ts != null) {
                      try { successMillis = java.time.Instant.parse(ts.toString()).toEpochMilli(); } catch (Exception e) {}
                    }
                  }

                  // Extract the s3 path after "Successfully processed file "
                  def fileName = null;
                  def mFile = /Successfully processed file\\s+(\\S+)/.matcher(msg);
                  if (mFile.find()) {
                    def path = mFile.group(1);
                    // take last segment after '/'
                    int idx = path.lastIndexOf('/');
                    fileName = idx >= 0 ? path.substring(idx + 1) : path;
                  }

                  return [
                    'found': true,
                    'success_doc': hit,
                    'success_message': msg,
                    'success_millis': successMillis,
                    'file_name': fileName
                  ];
                """
              }
            }
          }
        },
        {
          "latest_attempt_for_file": {
            "search": {
              "request": {
                "indices": [ "*-cloudwatch-*" ],
                "rest_total_hits_as_int": true,
                "body": {
                  "size": 1,
                  "sort": [
                    { "@timestamp": { "order": "desc" } }
                  ],
                  "_source": [
                    "@timestamp",
                    "cls.organization",
                    "record.environment",
                    "record.message"
                  ],
                  "query": {
                    "bool": {
                      "filter": [
                        { "term": { "cls.organization.keyword": "085047404459" } },
                        { "term": { "record.environment.keyword": "reporting-pipelines-spark-cluster" } }
                      ],
                      "must": [
                        {
                          "query_string": {
                            "default_field": "record.message",
                            "query": "Processing\\ file\\ {{ctx.payload.extract_file_and_time.file_name}}\\ attempt*"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "final_transform": {
            "transform": {
              "script": {
                "lang": "painless",
                "source": """
                  // Guardrails
                  if (ctx.payload.extract_file_and_time.found != true) return ['ok': false, 'reason': 'No success log found'];
                  if (ctx.payload.extract_file_and_time.file_name == null) return ['ok': false, 'reason': 'Could not extract file name from success message'];
                  if (ctx.payload.latest_attempt_for_file.hits.total == 0) return ['ok': false, 'reason': 'No attempt log found for extracted file'];

                  def succHit = ctx.payload.extract_file_and_time.success_doc;
                  def succMsg = ctx.payload.extract_file_and_time.success_message;
                  def succMillis = ctx.payload.extract_file_and_time.success_millis;
                  def fileName = ctx.payload.extract_file_and_time.file_name;

                  def attHit = ctx.payload.latest_attempt_for_file.hits.hits[0];
                  def attMsg = attHit._source.containsKey('record') && attHit._source.record != null ? attHit._source.record.message : attHit._source['record.message'];

                  // Parse attempt millis from message leading datetime, fallback to @timestamp
                  def attemptMillis = null;
                  def mTime = /^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/.matcher(attMsg != null ? attMsg : '');
                  if (mTime.find()) {
                    def dt = mTime.group(1).replace(' ', 'T') + 'Z';
                    try { attemptMillis = java.time.Instant.parse(dt).toEpochMilli(); } catch (Exception e) {}
                  }
                  if (attemptMillis == null) {
                    def ts = attHit._source['@timestamp'];
                    if (ts != null) {
                      try { attemptMillis = java.time.Instant.parse(ts.toString()).toEpochMilli(); } catch (Exception e) {}
                    }
                  }

                  if (succMillis == null || attemptMillis == null) return ['ok': false, 'reason': 'Could not parse timestamps'];

                  // Ensure attempt <= success, otherwise duration is suspicious (ingest ordering). If it happens, set duration to null.
                  Long durationMs = succMillis - attemptMillis;
                  if (durationMs < 0) durationMs = null;

                  def durationSec = durationMs != null ? (durationMs / 1000L) : null;
                  def durationHuman = null;
                  if (durationSec != null) {
                    long s = durationSec;
                    long h = s / 3600; s = s % 3600;
                    long m = s / 60;   s = s % 60;
                    durationHuman = (h > 0 ? h + 'h ' : '') + (m > 0 ? m + 'm ' : '') + s + 's';
                  }

                  return [
                    'ok': true,
                    'org': ctx.metadata.org,
                    'environment': ctx.metadata.environment,
                    'file_name': fileName,
                    'attempt_message': attMsg,
                    'success_message': succMsg,
                    'attempt_millis': attemptMillis,
                    'success_millis': succMillis,
                    'duration_ms': durationMs,
                    'duration_human': durationHuman,
                    'watch_execution_time': ctx.execution_time
                  ];
                """
              }
            }
          }
        }
      ]
    }
  },
  "condition": {
    "script": {
      "lang": "painless",
      "source": "return ctx.payload.final_transform.ok == true && ctx.payload.final_transform.duration_ms != null;"
    }
  },
  "actions": {
    "index_duration_doc": {
      "index": {
        "index": "reporting-cloud-data-pipeline",
        "doc_type": "_doc"
      }
    }
  },
  "transform": {
    "script": {
      "lang": "painless",
      "source": "return ctx.payload.final_transform;"
    }
  }
}