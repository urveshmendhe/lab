{
  "trigger": {
    "schedule": {
      "interval": "24h"
    }
  },
  "input": {
    "search": {
      "request": {
        "indices": ["*-cloudwatch-*"],
        "body": {
          "size": 10000,
          "query": {
            "bool": {
              "must": [
                {
                  "range": {
                    "@timestamp": {
                      "gte": "now-2d",
                      "lte": "now"
                    }
                  }
                },
                {
                  "term": {
                    "cls.organization.keyword": "085047404459"
                  }
                },
                {
                  "wildcard": {
                    "record.environment.keyword": "*reporting-pipelines-spark-cluster"
                  }
                },
                {
                  "bool": {
                    "should": [
                      { "match_phrase": { "record.message": "Processing file" } },
                      { "match_phrase": { "record.message": "Successfully processed file" } }
                    ],
                    "minimum_should_match": 1
                  }
                }
              ]
            }
          },
          "sort": [{ "@timestamp": "asc" }],
          "_source": ["@timestamp", "record.message", "record.environment", "cls.organization"]
        }
      }
    }
  },
  "transform": {
    "script": {
      "source": """
        Map fileEvents = new HashMap();
        List results = new ArrayList();
        def now = ctx.execution_time.toString();
        
        for (int i = 0; i < ctx.payload.hits.hits.size(); i++) {
          Map hit = ctx.payload.hits.hits.get(i);
          Map source = (Map)hit.get('_source');
          String timestamp = source.get('@timestamp').toString();
          long timestampMs = ((Number)((List)hit.get('sort')).get(0)).longValue();
          Map record = (Map)source.get('record');
          String message = record.get('message').toString();
          String environment = record.get('environment').toString();
          Map cls = (Map)source.get('cls');
          String organization = cls.get('organization').toString();
          
          String filename = null;
          
          if (message.indexOf('Processing file') >= 0 && message.indexOf('attempt') >= 0) {
            int startIdx = message.indexOf('Processing file') + 16;
            int endIdx = message.indexOf(' attempt');
            if (endIdx > startIdx) {
              filename = message.substring(startIdx, endIdx);
              if (!fileEvents.containsKey(filename)) {
                Map eventData = new HashMap();
                eventData.put('start', timestamp);
                eventData.put('startMs', Long.valueOf(timestampMs));
                eventData.put('environment', environment);
                eventData.put('organization', organization);
                fileEvents.put(filename, eventData);
              }
            }
          }
          
          if (message.indexOf('Successfully processed file') >= 0 && message.indexOf('with source') >= 0) {
            int endIdx = message.indexOf(' with source');
            if (endIdx > 0) {
              String pathPart = message.substring(0, endIdx);
              int lastSlash = pathPart.lastIndexOf('/');
              if (lastSlash >= 0) {
                filename = pathPart.substring(lastSlash + 1);
                if (fileEvents.containsKey(filename)) {
                  Map eventData = (Map)fileEvents.get(filename);
                  eventData.put('end', timestamp);
                  eventData.put('endMs', Long.valueOf(timestampMs));
                }
              }
            }
          }
        }
        
        for (entry in fileEvents.entrySet()) {
          String filename = entry.getKey();
          Map data = (Map)entry.getValue();
          
          if (data.containsKey('startMs') && data.containsKey('endMs')) {
            long startMs = ((Number)data.get('startMs')).longValue();
            long endMs = ((Number)data.get('endMs')).longValue();
            long durationMs = endMs - startMs;
            double durationSeconds = durationMs / 1000.0;
            
            // Calculate human-readable duration
            long totalSeconds = durationMs / 1000;
            long hours = totalSeconds / 3600;
            long minutes = (totalSeconds % 3600) / 60;
            long seconds = totalSeconds % 60;
            long millis = durationMs % 1000;
            
            StringBuilder durationHuman = new StringBuilder();
            if (hours > 0) {
              durationHuman.append(hours).append('h ');
            }
            if (minutes > 0 || hours > 0) {
              durationHuman.append(minutes).append('m ');
            }
            durationHuman.append(seconds).append('s');
            if (millis > 0) {
              durationHuman.append(' ').append(millis).append('ms');
            }
            
            Map result = new HashMap();
            result.put('filename', filename);
            result.put('start_time', data.get('start'));
            result.put('end_time', data.get('end'));
            result.put('duration_ms', durationMs);
            result.put('duration_seconds', durationSeconds);
            result.put('duration_human', durationHuman.toString().trim());
            result.put('environment', data.get('environment'));
            result.put('organization', data.get('organization'));
            result.put('calculated_at', now);
            results.add(result);
          }
        }
        
        Map payload = new HashMap();
        payload.put('results', results);
        return payload;
      """,
      "lang": "painless"
    }
  },
  "condition": {
    "script": {
      "source": "return ctx.payload.results != null && ctx.payload.results.size() > 0",
      "lang": "painless"
    }
  },
  "actions": {
    "index_results": {
      "foreach": "ctx.payload.results",
      "max_iterations": 1000,
      "index": {
        "index": "reporting-pipelines-spark-cluster"
      }
    }
  }
}