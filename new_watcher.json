{
  "trigger": {
    "schedule": { "interval": "24h" }
  },
  "metadata": {
    "org": "085047404459",
    "environment_suffix": "reporting-pipelines-spark-cluster",
    "source_index": "*-cloudwatch-*",
    "target_index": "reporting-cloud-data-pipeline"
  },
  "input": {
    "chain": {
      "inputs": [
        {
          "latest_success": {
            "search": {
              "request": {
                "indices": [ "*-cloudwatch-*" ],
                "body": {
                  "size": 1,
                  "sort": [ { "@timestamp": { "order": "desc" } } ],
                  "_source": [ "@timestamp", "cls.organization", "record.environment", "record.message" ],
                  "query": {
                    "bool": {
                      "filter": [
                        {
                          "range": {
                            "@timestamp": {
                              "gte": "now-24h",
                              "lte": "now"
                            }
                          }
                        },
                        { "term": { "cls.organization.keyword": "085047404459" } },
                        {
                          "wildcard": {
                            "record.environment.keyword": {
                              "value": "*reporting-pipelines-spark-cluster"
                            }
                          }
                        },
                        { "match_phrase": { "record.message": "Successfully processed file" } }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "extract_file_and_time": {
            "transform": {
              "script": {
                "lang": "painless",
                "source": """
                  if (ctx.payload.latest_success == null ||
                      ctx.payload.latest_success.hits == null ||
                      ctx.payload.latest_success.hits.hits == null ||
                      ctx.payload.latest_success.hits.hits.size() == 0) {
                    return ['found': false];
                  }

                  def hit = ctx.payload.latest_success.hits.hits[0];
                  def src = hit.get('_source');
                  if (src == null) return ['found': false];

                  // Safe read record.message (supports nested 'record':{message:""} or flattened 'record.message')
                  def msg = null;
                  def rec = src.get('record');
                  if (rec != null && rec instanceof java.util.Map) {
                    msg = ((java.util.Map)rec).get('message');
                  }
                  if (msg == null) msg = src.get('record.message');
                  if (msg == null) msg = '';

                  // Prefer @timestamp string for range-lte on attempt query
                  def successTs = src.get('@timestamp');

                  // Parse leading datetime in message: "YYYY-MM-DD HH:MM:SS" (UTC assumed)
                  def successMillis = null;
                  def mt = /^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/.matcher(msg);
                  if (mt.find()) {
                    def dt = mt.group(1).replace(' ', 'T') + 'Z';
                    try { successMillis = java.time.Instant.parse(dt).toEpochMilli(); } catch (Exception e) {}
                  }
                  // fallback to @timestamp
                  if (successMillis == null && successTs != null) {
                    try { successMillis = java.time.Instant.parse(successTs.toString()).toEpochMilli(); } catch (Exception e) {}
                  }

                  // Extract filename from "Successfully processed file <pathOrFile>"
                  def fileName = null;
                  def mf = /Successfully processed file\\s+(\\S+)/.matcher(msg);
                  if (mf.find()) {
                    def path = mf.group(1);
                    int idx = path.lastIndexOf('/');
                    fileName = idx >= 0 ? path.substring(idx + 1) : path;
                  }

                  return [
                    'found': true,
                    'success_message': msg,
                    'success_millis': successMillis,
                    'success_ts': successTs,
                    'file_name': fileName
                  ];
                """
              }
            }
          }
        },
        {
          "latest_attempt_for_file": {
            "search": {
              "request": {
                "indices": [ "*-cloudwatch-*" ],
                "body": {
                  "size": 1,
                  "sort": [ { "@timestamp": { "order": "desc" } } ],
                  "_source": [ "@timestamp", "cls.organization", "record.environment", "record.message" ],
                  "query": {
                    "bool": {
                      "filter": [
                        {
                          "range": {
                            "@timestamp": {
                              "gte": "now-24h",
                              "lte": "{{ctx.payload.extract_file_and_time.success_ts}}"
                            }
                          }
                        },
                        { "term": { "cls.organization.keyword": "085047404459" } },
                        {
                          "wildcard": {
                            "record.environment.keyword": {
                              "value": "*reporting-pipelines-spark-cluster"
                            }
                          }
                        }
                      ],
                      "must": [
                        {
                          "query_string": {
                            "default_field": "record.message",
                            "query": "Processing\\ file\\ {{ctx.payload.extract_file_and_time.file_name}}\\ attempt*"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "final_transform": {
            "transform": {
              "script": {
                "lang": "painless",
                "source": """
                  if (ctx.payload.extract_file_and_time == null || ctx.payload.extract_file_and_time.found != true) {
                    return ['ok': false, 'reason': 'No success log found in last 24h'];
                  }

                  def fileName = ctx.payload.extract_file_and_time.file_name;
                  if (fileName == null) return ['ok': false, 'reason': 'Could not extract file name from success message'];

                  if (ctx.payload.latest_attempt_for_file == null ||
                      ctx.payload.latest_attempt_for_file.hits == null ||
                      ctx.payload.latest_attempt_for_file.hits.hits == null ||
                      ctx.payload.latest_attempt_for_file.hits.hits.size() == 0) {
                    return ['ok': false, 'reason': 'No attempt log found for extracted file (last 24h, up to success ts)'];
                  }

                  def succMsg = ctx.payload.extract_file_and_time.success_message;
                  def succMillis = ctx.payload.extract_file_and_time.success_millis;

                  def attHit = ctx.payload.latest_attempt_for_file.hits.hits[0];
                  def attSrc = attHit.get('_source');
                  if (attSrc == null) return ['ok': false, 'reason': 'Attempt hit missing _source'];

                  // Safe get attempt message
                  def attMsg = null;
                  def rec = attSrc.get('record');
                  if (rec != null && rec instanceof java.util.Map) {
                    attMsg = ((java.util.Map)rec).get('message');
                  }
                  if (attMsg == null) attMsg = attSrc.get('record.message');
                  if (attMsg == null) attMsg = '';

                  // Parse attempt millis from message leading datetime, fallback to @timestamp
                  def attemptMillis = null;
                  def mt = /^(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/.matcher(attMsg);
                  if (mt.find()) {
                    def dt = mt.group(1).replace(' ', 'T') + 'Z';
                    try { attemptMillis = java.time.Instant.parse(dt).toEpochMilli(); } catch (Exception e) {}
                  }
                  if (attemptMillis == null) {
                    def ts = attSrc.get('@timestamp');
                    if (ts != null) {
                      try { attemptMillis = java.time.Instant.parse(ts.toString()).toEpochMilli(); } catch (Exception e) {}
                    }
                  }

                  if (succMillis == null || attemptMillis == null) {
                    return ['ok': false, 'reason': 'Could not parse timestamps'};
                  }

                  def durationMs = (long)(succMillis - attemptMillis);
                  if (durationMs < 0) durationMs = null;

                  def durationSec = durationMs != null ? (long)(durationMs / 1000L) : null;

                  def durationHuman = null;
                  if (durationSec != null) {
                    long s = durationSec;
                    long h = (long)(s / 3600L); s = s % 3600L;
                    long m = (long)(s / 60L);   s = s % 60L;
                    durationHuman = (h > 0 ? h + 'h ' : '') + (m > 0 ? m + 'm ' : '') + s + 's';
                  }

                  return [
                    'ok': true,
                    'org': ctx.metadata.org,
                    'environment_suffix': ctx.metadata.environment_suffix,
                    'file_name': fileName,
                    'attempt_message': attMsg,
                    'success_message': succMsg,
                    'attempt_millis': attemptMillis,
                    'success_millis': succMillis,
                    'duration_ms': durationMs,
                    'duration_human': durationHuman,
                    'watch_execution_time': ctx.execution_time
                  ];
                """
              }
            }
          }
        }
      ]
    }
  },
  "condition": {
    "script": {
      "lang": "painless",
      "source": "return ctx.payload.final_transform.ok == true && ctx.payload.final_transform.duration_ms != null;"
    }
  },
  "transform": {
    "script": {
      "lang": "painless",
      "source": "return ctx.payload.final_transform;"
    }
  },
  "actions": {
    "index_duration_doc": {
      "index": {
        "index": "reporting-cloud-data-pipeline"
      }
    }
  }
}